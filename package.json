{
  "name": "tiem-hoa-nho-cua-toi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n game,server \"vite\" \"tsx watch server/index.ts\"",
    "server": "tsx server/index.ts",
    "build": "tsc && vite build && tsc -p server/tsconfig.json && tsx server/copyMigrations.ts",
    "start": "node dist-server/server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc && tsc -p server/tsconfig.json --noEmit",
    "check-assets": "vite-node scripts/check-assets.ts",
    "db:migrate": "tsx server/commands.ts migrate",
    "db:seed": "tsx server/commands.ts seed",
    "catalog:export": "tsx server/commands.ts export",
    "catalog:import": "tsx server/commands.ts import"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "image-size": "^2.0.4",
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-node": "^5.1.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
